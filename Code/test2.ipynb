   "source": [
    "from gurobipy import Model, GRB\n",
    "\n",
    "m = Model()\n",
    "x = m.addVar(name=\"x\")\n",
    "y = m.addVar(name=\"y\")\n",
    "m.setObjective(x + y, GRB.MAXIMIZE)\n",
    "m.addConstr(x + 2*y <= 4)\n",
    "m.optimize()\n",
    "print(x.X, y.X)\n"
   ]
  }
